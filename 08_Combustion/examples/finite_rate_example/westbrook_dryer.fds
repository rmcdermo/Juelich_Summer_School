&HEAD CHID='westbrook_dryer', TITLE='Simple propane fire plume with Westbrook and Dryer reaction.'/

! Geometry: FDS Verification/Flowfields/realizable_mass_fractions.fds
! Kinetics: FDS User Guide, single-step Westbrook and Dryer propane example.

&MESH IJK=20,20,30, XB=-1.0,1.0,-1.0,1.0,0.0,3.0/

&TIME T_END=20.0/

&COMB INITIAL_UNMIXED_FRACTION=0.9/

&SPEC ID='PROPANE' /
&SPEC ID='SOOT' /
&SPEC ID='NITROGEN',       MASS_FRACTION_0=0.763077, BACKGROUND=.TRUE./
&SPEC ID='OXYGEN',         MASS_FRACTION_0=0.231181/
&SPEC ID='WATER VAPOR',    MASS_FRACTION_0=0.005149/
&SPEC ID='CARBON DIOXIDE', MASS_FRACTION_0=0.000592/

! Soot yield = 0.01 kg/kg propane; soot is pure carbon.
! nu_soot = 0.01 * 44.09562 / 12.0107 = 0.036713614.
! Carbon and oxygen balance: nu_CO2 = 3 - nu_soot; nu_O2 = -(5 - nu_soot).
&REAC ID = 'R1'
      FUEL = 'PROPANE'
      A = 8.6e11
      E = 125520
      SPEC_ID_NU = 'PROPANE','OXYGEN','CARBON DIOXIDE','WATER VAPOR','SOOT'
      NU = -1,-4.963286386,2.963286386,4,0.036713614
      SPEC_ID_N_S = 'PROPANE','OXYGEN'
      N_S = 0.1,1.65 /

&SURF ID='burner',
      FYI='500 kW/m2 burner',
      COLOR='RED',
      SPEC_ID(1)='PROPANE', MASS_FLUX(1)=0.01079, TAU_MF(1)=0.
      TMP_FRONT=1000.
      HEAT_TRANSFER_COEFFICIENT=20./

! Species histories at the original realizability probe location.
&DEVC XYZ=0.0,0.0,0.2, QUANTITY='MASS FRACTION', SPEC_ID='OXYGEN', ID='O2' /
&DEVC XYZ=0.0,0.0,0.2, QUANTITY='MASS FRACTION', SPEC_ID='PROPANE', ID='C3H8' /
&DEVC XYZ=0.0,0.0,0.2, QUANTITY='MASS FRACTION', SPEC_ID='CARBON DIOXIDE', ID='CO2' /
&DEVC XYZ=0.0,0.0,0.2, QUANTITY='MASS FRACTION', SPEC_ID='WATER VAPOR', ID='H2O' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&VENT XB=-0.5,0.5,-0.5,0.5,0.0,0.0, SURF_ID='burner' /

&SLCF PBY=0.0, QUANTITY='VELOCITY', VECTOR=.TRUE., /
&SLCF PBY=0.0, QUANTITY='TEMPERATURE',                             CELL_CENTERED=.TRUE. /
&SLCF PBY=0.0, QUANTITY='MASS FRACTION', SPEC_ID='PROPANE',        CELL_CENTERED=.TRUE. /
&SLCF PBY=0.0, QUANTITY='MASS FRACTION', SPEC_ID='OXYGEN',         CELL_CENTERED=.TRUE. /
&SLCF PBY=0.0, QUANTITY='MASS FRACTION', SPEC_ID='WATER VAPOR',    CELL_CENTERED=.TRUE. /
&SLCF PBY=0.0, QUANTITY='MASS FRACTION', SPEC_ID='CARBON DIOXIDE', CELL_CENTERED=.TRUE. /

&TAIL /
