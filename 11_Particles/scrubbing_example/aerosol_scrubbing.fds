&HEAD CHID='aerosol_scrubbing',TITLE='Verification case for aerosol scrubbing'/

&MESH XB=-2.0,2.0,-2.0,2.0,0.0,3.0,IJK=40,40,30/

&MISC DEPOSITION=.FALSE.,GRAVITATIONAL_SETTLING=.FALSE.,THERMOPHORETIC_SETTLING=.FALSE.,AEROSOL_SCRUBBING=.TRUE./

&TIME T_END=1.,DT=0.01/

&SPEC ID='WATER VAPOR'/
&SPEC ID='SOOT',AEROSOL=.TRUE.,MEAN_DIAMETER=1.E-6,MASS_FRACTION_0=0.0001/

&PART ID='water drops',SPEC_ID='WATER VAPOR',DIAMETER=750.,SAMPLING_FACTOR=5/

&SLCF QUANTITY='MASS FRACTION',SPEC_ID='SOOT',PBY=0/

&PROP ID='K-11', QUANTITY='SPRINKLER LINK TEMPERATURE', OFFSET=0.15, PART_ID='water drops',
      FLOW_RATE=60., PARTICLE_VELOCITY=10., SPRAY_ANGLE=0.,80., SMOKEVIEW_ID='sprinkler_upright' /

&DEVC XYZ=0.0,0.0,2.8, PROP_ID='K-11', ID='Spr_1', QUANTITY='TIME', SETPOINT=0.  /


&TAIL /
