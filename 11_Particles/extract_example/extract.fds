&HEAD CHID='extract', TITLE='Single Sprinkler Test Case' /

&MESH IJK=25,25,25, XB=-5.0,5.0,-5.0,5.0,0.0,5.0/

&RADI RADIATION=.FALSE./
&TIME T_END=10. /
&SPEC ID='WATER VAPOR'/
&PART ID='water drops', SPEC_ID='WATER VAPOR', QUANTITIES(1:3)='PARTICLE DIAMETER','PARTICLE TEMPERATURE','PARTICLE AGE',
      DIAMETER=750., SAMPLING_FACTOR=1 /

&PROP ID='K-11', QUANTITY='SPRINKLER LINK TEMPERATURE', OFFSET=0.30, PART_ID='water drops',
      FLOW_RATE=180., PARTICLE_VELOCITY=10., SPRAY_ANGLE=0.,50., SMOKEVIEW_ID='sprinkler_upright' /


&SURF ID='INLET',VEL=1,COLOR='BLUE'/,PARTICLE_EXTRACTION_VELOCITY=0.1/
&OBST XB=-3,3,-3,3,2.0,2.2/
&VENT XB=-2.2,2.2,-2.2,2.2,2.2,2.2,SURF_ID='INLET'/

&DEVC XYZ=0.0,0.0,4.9, PROP_ID='K-11', ID='Spr_1', QUANTITY='TIME', SETPOINT=0.  /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /




&TAIL /
